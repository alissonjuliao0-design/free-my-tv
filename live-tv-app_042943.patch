+    private static final int TRACK_MAX_FRAMES = 5;
+    private static final long TRACK_STEP_MS = 5000;
+    /** The breathing is applied in steps this fine: no change you can see, a third of the redraws. */
+    private static final float ALPHA_STEPS = 64f;
+    /** The glows drawn for apps, kept: going back to an app already seen costs nothing. */
+    private static final android.util.LruCache<Integer, Bitmap> appGlows = new android.util.LruCache<>(8);
+    /** Lightning style: how many different bolt pictures it flickers between, and the ones drawn for apps. */
+    private static final int BOLT_FRAMES = 4;
+    private static final android.util.LruCache<Integer, Bitmap[]> appBolts = new android.util.LruCache<>(4);
+    /** The frame the colours are read from, small: 64 by 36 is plenty for a glow. */
+    private static final int FW = 64, FH = 36;
+
+    /** The glow (or the lightning, Home Settings > Neon style) over the home screen, or null: off, or Cinema mode. */
+    static NeonView create(Context c) {
+        int scheme = Prefs.neon();
+        if (scheme <= 0 || scheme >= COLORS.length || Prefs.cinema()) return null;
+        // Lite mode: keep a simple fixed glow only — no follow wallpaper/app, no lightning (those cost the most).
+        boolean lite = Prefs.lite();
+        int mode = lite ? MODE_FIXED
+                : scheme == FOLLOW ? MODE_WALLPAPER : scheme == APP ? MODE_APP : MODE_FIXED;
+        int fixedScheme = (scheme == FOLLOW || scheme == APP) ? 2 : scheme;
+        Edges first = gradient(COLORS[mode == MODE_FIXED ? fixedScheme : 2]);
+        // Lightning spikes: show a first bolt picture immediately so the edge is never blank, then flicker in more.
+        if (Prefs.neonStyle() == 1 && !lite) {
+            Bitmap firstBolt = boltFrame(first, 4242L);
+            NeonView bolts = new NeonView(c, firstBolt, mode, true);
+            bolts.setAlpha(1f);
+            bolts.drawLater(first);
+            return bolts;
+        }
+        NeonView view = new NeonView(c, render(first), mode, false);
+        if (lite) view.setAlpha(0.85f);   // static: no breathing animation in Lite
+        return view;
+    }
+
+    /** The colour the clock's neon style uses: the middle of the scheme in use, or a cyan when it follows something. */
+    static int accent() {
+        int scheme = Prefs.neon();
+        return scheme >= 1 && scheme < COLORS.length && COLORS[scheme].length > 1 ? COLORS[scheme][1] : 0xFF00E5FF;
+    }
+
+    // MARK: - Following the apps
+
+    private static final java.util.Map<String, Integer> appColors = new java.util.HashMap<>();
+
+    /** The glow's colour for an app: its brand colour, or the main colour of its card or logo. 0: none to show. */
+    static int appColor(HomeApps.Item it) {
+        if (it == null) return 0;
+        String key = it.key != null ? it.key : it.label;
+        Integer known = key == null ? null : appColors.get(key);
+        if (known != null) return known;
+        int c = HomeApps.brand(it.key);
+        if (c == 0) c = dominant(it.tile != null ? it.tile : it.logo);
+        if (c == 0) return it.kind == HomeApps.APP ? accent() : 0;   // the card isn't loaded yet: not remembered
+        c = vivid(c);
+        if (key != null) appColors.put(key, c);
+        return c;
+    }
+
+    /** The colour that stands out most in a picture: the average of its pixels, weighted by how vivid they are. */
+    private static int dominant(Bitmap b) {
+        if (b == null || b.isRecycled()) return 0;
+        Bitmap small = Bitmap.createScaledBitmap(b, 16, 9, true);
+        int[] px = new int[16 * 9];
+        small.getPixels(px, 0, 16, 0, 0, 16, 9);
+        float[] hsv = new float[3];
+        double r = 0, g = 0, bl = 0, total = 0;
+        for (int c : px) {
+            if (Color.alpha(c) < 128) continue;
+            Color.colorToHSV(c, hsv);
+            double w = hsv[1] * hsv[2];
+            w = w * w + 0.0005;
+            r += Color.red(c) * w;
+            g += Color.green(c) * w;
+            bl += Color.blue(c) * w;
+            total += w;
+        }
+        if (total <= 0) return 0;
+        return Color.rgb((int) (r / total), (int) (g / total), (int) (bl / total));
+    }
+
+    /** The same colour with its hue turned by some degrees. */
+    private static int shift(int c, float degrees) {
+        float[] hsv = new float[3];
+        Color.colorToHSV(c, hsv);
+        hsv[0] = (hsv[0] + degrees + 360f) % 360f;
+        return Color.HSVToColor(255, hsv);
+    }
+
+    // MARK: - Drawing
+
+    private static final float[] WIDTHS = {26f, 12f, 3f}, BLURS = {30f, 12f, 0f}, INSETS = {10f, 6f, 1.5f};
+    private static final int[] ALPHAS = {140, 190, 255};
+    private static final int W = 640, H = 360;
+
+    /** The colours of the four edges, each from one end to the other: top and bottom left to right, sides top to bottom. */
+    private static final class Edges {
+        int[] top, right, bottom, left;
+    }
+
+    private static Edges gradient(int[] colors) {
+        Edges e = new Edges();
+        e.top = colors;
+        e.bottom = colors;
+        // The sides run from the top colour to the bottom colour's: the first and the last of the gradient.
+        e.right = new int[] {colors[colors.length - 1], colors[colors.length - 1]};
+        e.left = new int[] {colors[0], colors[0]};
+        return e;
+    }
+
+    /** A soft wide halo, a tighter one, and the thin bright line, on each of the four edges. */
+    private static Bitmap render(Edges e) {
+        Bitmap bitmap = Bitmap.createBitmap(W, H, Bitmap.Config.ARGB_8888);
+        Canvas canvas = new Canvas(bitmap);
+        Paint p = new Paint(Paint.ANTI_ALIAS_FLAG);
+        p.setStyle(Paint.Style.STROKE);
+        p.setStrokeCap(Paint.Cap.SQUARE);
+        for (int i = 0; i < WIDTHS.length; i++) {
+            float in = INSETS[i];
+            p.setStrokeWidth(WIDTHS[i]);
+            p.setAlpha(ALPHAS[i]);
+            p.setMaskFilter(BLURS[i] > 0 ? new BlurMaskFilter(BLURS[i], BlurMaskFilter.Blur.NORMAL) : null);
+            p.setShader(new LinearGradient(in, 0, W - in, 0, e.top, null, Shader.TileMode.CLAMP));
+            canvas.drawLine(in, in, W - in, in, p);
+            p.setShader(new LinearGradient(in, 0, W - in, 0, e.bottom, null, Shader.TileMode.CLAMP));
+            canvas.drawLine(in, H - in, W - in, H - in, p);
+            p.setShader(new LinearGradient(0, in, 0, H - in, e.left, null, Shader.TileMode.CLAMP));
+            canvas.drawLine(in, in, in, H - in, p);
+            p.setShader(new LinearGradient(0, in, 0, H - in, e.right, null, Shader.TileMode.CLAMP));
+            canvas.drawLine(W - in, in, W - in, H - in, p);
+        }
+        return bitmap;
+    }
+
+    // MARK: - Following the wallpaper
+
+    /** A small frame of the wallpaper: the photo, or the video at the moment it is playing. Null when it can't be read. */
+    private static Bitmap frame(File f, boolean video, long positionMs) {
+        if (!video) {
+            BitmapFactory.Options o = new BitmapFactory.Options();
+            o.inJustDecodeBounds = true;
+            BitmapFactory.decodeFile(f.getPath(), o);
+            int sample = 1;
+            while (o.outWidth / (sample * 2) >= 128) sample *= 2;
+            o = new BitmapFactory.Options();
+            o.inSampleSize = sample;
+            Bitmap b = BitmapFactory.decodeFile(f.getPath(), o);
+            return b == null ? null : Bitmap.createScaledBitmap(b, FW, FH, true);
+        }
+        MediaMetadataRetriever r = new MediaMetadataRetriever();
+        try {
+            r.setDataSource(f.getPath());
+            long us = positionMs * 1000L;
+            // The nearest key frame: the cheapest to read, and the colours of a video change slowly anyway.
+            Bitmap b = Build.VERSION.SDK_INT >= 27
+                    ? r.getScaledFrameAtTime(us, MediaMetadataRetriever.OPTION_CLOSEST_SYNC, FW, FH)
+                    : r.getFrameAtTime(us, MediaMetadataRetriever.OPTION_CLOSEST_SYNC);
+            return b == null ? null : Bitmap.createScaledBitmap(b, FW, FH, true);
+        } catch (RuntimeException e) {
+            return null;
+        } finally {
+            try {
+                r.release();
+            } catch (Exception ignored) {
+            }
+        }
+    }
+
+    private static int average(int[] px, int x0, int y0, int x1, int y1) {
+        long r = 0, g = 0, b = 0;
+        int n = 0;
+        for (int y = y0; y < y1; y++) {
+            for (int x = x0; x < x1; x++) {
+                int c = px[y * FW + x];
+                r += Color.red(c);
+                g += Color.green(c);
+                b += Color.blue(c);
+                n++;
+            }
+        }
+        return n == 0 ? Color.BLACK : Color.rgb((int) (r / n), (int) (g / n), (int) (b / n));
+    }
+
+    /** More colour and light for a glow; a dark scene keeps a dim glow, and a grey one stays grey. */
+    private static int vivid(int c) {
+        float[] hsv = new float[3];
+        Color.colorToHSV(c, hsv);
+        hsv[1] = hsv[1] > 0.08f ? Math.min(1f, hsv[1] * 1.3f + 0.15f) : 0f;
+        hsv[2] = Math.max(0.25f, Math.min(1f, hsv[2] * 1.7f));
+        return Color.HSVToColor(255, hsv);
+    }
+
+    /** The colours of the four edges of a frame (small, so a whole video's worth can be kept). */
+    private static Edges edgesOf(Bitmap frame) {
+        int[] px = new int[FW * FH];
+        frame.getPixels(px, 0, FW, 0, 0, FW, FH);
+        Edges e = new Edges();
+        e.top = new int[8];
+        e.bottom = new int[8];
+        e.left = new int[4];
+        e.right = new int[4];
+        int depth = 4;
+        for (int i = 0; i < 8; i++) {
+            e.top[i] = vivid(average(px, i * 8, 0, i * 8 + 8, depth));
+            e.bottom[i] = vivid(average(px, i * 8, FH - depth, i * 8 + 8, FH));
+        }
+        for (int j = 0; j < 4; j++) {
+            e.left[j] = vivid(average(px, 0, j * 9, depth, j * 9 + 9));
+            e.right[j] = vivid(average(px, FW - depth, j * 9, FW, j * 9 + 9));
+        }
+        return e;
+    }
+
+    // MARK: - Lightning
+
+    private static final float BOLT_INSET = 8f;
+
+    /** A place along an edge (t) and how far in from the edge it is (off), as a point of the picture. */
+    private static void boltPoint(int edge, float t, float off, float[] out) {
+        float in = BOLT_INSET;
+        switch (edge) {
+            case 0: out[0] = in + t; out[1] = in + off; break;             // top
+            case 1: out[0] = in + t; out[1] = H - in - off; break;         // bottom
+            case 2: out[0] = in + off; out[1] = in + t; break;             // left
+            default: out[0] = W - in - off; out[1] = in + t; break;        // right
+        }
+    }
+
+    /** One edge's bolt: a jagged line along the edge with sharp spikes into the picture, some of them forked. */
+    private static Path boltPath(int edge, java.util.Random rnd) {
+        float length = (edge < 2 ? W : H) - 2 * BOLT_INSET;
+        Path path = new Path();
+        float[] p = new float[2];
+        float t = 0, off = rnd.nextFloat() * 4f;
+        boltPoint(edge, t, off, p);
+        path.moveTo(p[0], p[1]);
+        while (t < length) {
+            t = Math.min(length, t + 7f + rnd.nextFloat() * 20f);
+            boolean spike = rnd.nextFloat() < 0.2f;
+            off = spike ? 14f + rnd.nextFloat() * 24f : rnd.nextFloat() * 7f;
+            boltPoint(edge, t, off, p);
+            path.lineTo(p[0], p[1]);
+            if (spike && rnd.nextFloat() < 0.6f) {   // a fork off the tip: further in, a little to the side, with a kink
+                float x = p[0], y = p[1];
+                float side = (rnd.nextBoolean() ? 1 : -1) * (6f + rnd.nextFloat() * 14f);
+                float deeper = off + 10f + rnd.nextFloat() * 20f;
+                boltPoint(edge, Math.max(0f, Math.min(length, t + side * 0.4f)), off + (deeper - off) * 0.5f, p);
+                path.lineTo(p[0], p[1]);
+                boltPoint(edge, Math.max(0f, Math.min(length, t + side)), deeper, p);
+                path.lineTo(p[0], p[1]);
+                path.moveTo(x, y);   // back to the tip: the main bolt carries on from there
+            }
+        }
+        return path;
+    }
+
+    private static Shader boltShader(Edges e, int edge) {
+        float in = BOLT_INSET;
+        switch (edge) {
+            case 0: return new LinearGradient(in, 0, W - in, 0, e.top, null, Shader.TileMode.CLAMP);
+            case 1: return new LinearGradient(in, 0, W - in, 0, e.bottom, null, Shader.TileMode.CLAMP);
+            case 2: return new LinearGradient(0, in, 0, H - in, e.left, null, Shader.TileMode.CLAMP);
+            default: return new LinearGradient(0, in, 0, H - in, e.right, null, Shader.TileMode.CLAMP);
+        }
+    }
+
+    /** One picture of the bolts on the four edges: a wide soft halo, a tighter one, and a white-hot thin core. */
+    private static Bitmap boltFrame(Edges e, long seed) {
+        Bitmap bitmap = Bitmap.createBitmap(W, H, Bitmap.Config.ARGB_8888);
+        Canvas canvas = new Canvas(bitmap);
+        java.util.Random rnd = new java.util.Random(seed);
+        Path[] paths = new Path[4];
+        for (int i = 0; i < 4; i++) paths[i] = boltPath(i, rnd);
+        Paint p = new Paint(Paint.ANTI_ALIAS_FLAG);
+        p.setStyle(Paint.Style.STROKE);
+        p.setStrokeJoin(Paint.Join.MITER);
+        p.setStrokeMiter(8f);
+        p.setStrokeCap(Paint.Cap.ROUND);
+        float[] widths = {18f, 7f, 2.5f};
+        float[] blurs = {14f, 4f, 0f};
+        int[] alphas = {160, 230, 255};
+        for (int layer = 0; layer < 3; layer++) {
+            p.setStrokeWidth(widths[layer]);
+            p.setMaskFilter(blurs[layer] > 0 ? new BlurMaskFilter(blurs[layer], BlurMaskFilter.Blur.NORMAL) : null);
+            for (int edge = 0; edge < 4; edge++) {
+                if (layer < 2) {
+                    p.setShader(boltShader(e, edge));
+                } else {
+                    p.setShader(null);
+                    p.setColor(0xFFFFFFFF);
+                }
+                p.setAlpha(alphas[layer]);
+                canvas.drawPath(paths[edge], p);
+            }
+        }
+        return bitmap;
+    }
+
+    /** The bolt pictures for some colours: always the same shapes for the same colours. */
+    private static Bitmap[] bolts(Edges e) {
+        Bitmap[] out = new Bitmap[BOLT_FRAMES];
+        for (int i = 0; i < out.length; i++) out[i] = boltFrame(e, 4242L + i * 7919L);
+        return out;
+    }
+
+    /** A short number for a set of edge colours (each channel to 4 bits): the same colours, the same number. */
+    private static int signature(Edges e) {
+        int h = 1;
+        for (int[] colors : new int[][] {e.top, e.right, e.bottom, e.left}) {
+            for (int c : colors) h = h * 31 + (((c >> 20) & 0xF) << 8 | ((c >> 12) & 0xF) << 4 | ((c >> 4) & 0xF));
+        }
+        return h;
+    }
+
+    // MARK: - The video's colours, read once
+
+    /** The edge colours of a video at evenly spaced moments. Empty when the video can't be read (not tried again). */
+    private static final class Track {
+        final File file;
+        final long[] at;
+        final Edges[] edges;
+
+        Track(File file, long[] at, Edges[] edges) {
+            this.file = file;
+            this.at = at;
+            this.edges = edges;
+        }
+
+        /** The frame closest to a moment of the video. */
+        int indexAt(long positionMs) {
+            int best = 0;
+            long gap = Long.MAX_VALUE;
+            for (int i = 0; i < at.length; i++) {
+                long d = Math.abs(at[i] - positionMs);
+                if (d < gap) {
+                    gap = d;
+                    best = i;
+                }
+            }
+            return best;
+        }
+    }
+
+    /** Disk cache key for a video's edge colours (path + size + mtime). */
+    private static String trackCacheKey(File f) {
+        return "neon-track-" + Integer.toHexString(f.getPath().hashCode()) + "-" + f.length() + "-" + f.lastModified() + ".bin";
+    }
+
+    private static Track loadTrackCache(Context c, File f) {
+        File cache = new File(c.getCacheDir(), trackCacheKey(f));
+        if (!cache.isFile()) return null;
+        try (java.io.DataInputStream in = new java.io.DataInputStream(new java.io.BufferedInputStream(new java.io.FileInputStream(cache)))) {
+            int n = in.readInt();
+            if (n <= 0 || n > TRACK_MAX_FRAMES) return null;
+            long[] at = new long[n];
+            Edges[] edges = new Edges[n];
+            for (int i = 0; i < n; i++) {
+                at[i] = in.readLong();
+                edges[i] = readEdges(in);
+            }
+            return new Track(f, at, edges);
+        } catch (Exception e) {
+            //noinspection ResultOfMethodCallIgnored
+            cache.delete();
+            return null;
+        }
+    }
+
+    private static void saveTrackCache(Context c, File f, Track t) {
+        if (t == null || t.edges.length == 0) return;
+        File cache = new File(c.getCacheDir(), trackCacheKey(f));
+        File tmp = new File(cache.getPath() + ".tmp");
+        try (java.io.DataOutputStream out = new java.io.DataOutputStream(new java.io.BufferedOutputStream(new java.io.FileOutputStream(tmp)))) {
+            out.writeInt(t.edges.length);
+            for (int i = 0; i < t.edges.length; i++) {
+                out.writeLong(t.at[i]);
+                writeEdges(out, t.edges[i]);
+            }
+            out.flush();
+            //noinspection ResultOfMethodCallIgnored
+            tmp.renameTo(cache);
+        } catch (Exception e) {
+            //noinspection ResultOfMethodCallIgnored
+            tmp.delete();
+        }
+    }
+
+    private static void writeEdges(java.io.DataOutputStream out, Edges e) throws java.io.IOException {
+        writeColors(out, e.top);
+        writeColors(out, e.right);
+        writeColors(out, e.bottom);
+        writeColors(out, e.left);
+    }
+
+    private static Edges readEdges(java.io.DataInputStream in) throws java.io.IOException {
+        Edges e = new Edges();
+        e.top = readColors(in);
+        e.right = readColors(in);
+        e.bottom = readColors(in);
+        e.left = readColors(in);
+        return e;
+    }
+
+    private static void writeColors(java.io.DataOutputStream out, int[] c) throws java.io.IOException {
+        out.writeInt(c.length);
+        for (int v : c) out.writeInt(v);
+    }
+
+    private static int[] readColors(java.io.DataInputStream in) throws java.io.IOException {
+        int n = in.readInt();
+        int[] c = new int[Math.max(0, Math.min(16, n))];
+        for (int i = 0; i < c.length; i++) c[i] = in.readInt();
+        return c;
+    }
+
+    /**
+     * Reads the colours of the video's edges sparsely, on one retriever, once, off the main thread.
+     * Must NOT run while Wallpaper's VideoView is playing the same file (second decoder freezes many TVs).
+     */
+    private static Track buildTrack(Context c, File f) {
+        Track cached = loadTrackCache(c, f);
+        if (cached != null) return cached;
+        MediaMetadataRetriever r = new MediaMetadataRetriever();
+        java.util.ArrayList<Long> times = new java.util.ArrayList<>();
+        java.util.ArrayList<Edges> list = new java.util.ArrayList<>();
+        try {
+            r.setDataSource(f.getPath());
+            String d = r.extractMetadata(MediaMetadataRetriever.METADATA_KEY_DURATION);
+            long duration = d == null ? 0 : Long.parseLong(d);
+            if (duration <= 0) duration = TRACK_STEP_MS;
+            int n = (int) Math.max(1, Math.min(TRACK_MAX_FRAMES, duration / TRACK_STEP_MS));
+            long step = duration / n;
+            for (int i = 0; i < n; i++) {
+                long at = i * step + step / 2;
+                Bitmap b = Build.VERSION.SDK_INT >= 27
+                        ? r.getScaledFrameAtTime(at * 1000L, MediaMetadataRetriever.OPTION_CLOSEST_SYNC, FW, FH)
+                        : r.getFrameAtTime(at * 1000L, MediaMetadataRetriever.OPTION_CLOSEST_SYNC);
+                if (b != null) {
+                    times.add(at);
+                    list.add(edgesOf(Bitmap.createScaledBitmap(b, FW, FH, true)));
+                    if (b.getWidth() != FW || b.getHeight() != FH) b.recycle();
+                }
+                try {
+                    Thread.sleep(300);   // give the decoder room; VideoView must not be open on this file
+                } catch (InterruptedException ie) {
+                    break;
+                }
+            }
+        } catch (RuntimeException e) {
+            AppLog.w("neon track: " + e.getMessage());
+        } finally {
+            try {
+                r.release();
+            } catch (Exception ignored) {
+            }
+        }
+        long[] at = new long[times.size()];
+        for (int i = 0; i < at.length; i++) at[i] = times.get(i);
+        Track built = new Track(f, at, list.toArray(new Edges[0]));
+        saveTrackCache(c, f, built);
+        return built;
+    }
+
+    /** When the home screen pauses, build/cache the video track safely (VideoView is paused then). */
+    /**
+     * Build the video colour track only when the VideoView is NOT playing (home paused, or wallpaper just chosen).
+     * Safe to call often: no-ops when the cache already exists or neon is not following the wallpaper.
+     */
+    static void preloadTrack(Context c) {
+        if (Prefs.neon() != FOLLOW) return;
+        File f = Wallpaper.shownFile();
+        if (f == null || !Wallpaper.isVideo(f)) return;
+        if (loadTrackCache(c.getApplicationContext(), f) != null) return;
+        if (Wallpaper.videoPlaying()) return;   // never race the live wallpaper decoder
+        final Context app = c.getApplicationContext();
+        final File file = f;
+        worker.execute(() -> buildTrack(app, file));
+    }
+
+    /** Prefill colours for a video path chosen in Settings (file is not the live wallpaper yet). */
+    static void preloadTrackFile(Context c, File f) {
+        if (f == null || !f.isFile() || !Wallpaper.isVideo(f)) return;
+        if (Prefs.neon() != FOLLOW) return;
+        if (loadTrackCache(c.getApplicationContext(), f) != null) return;
+        final Context app = c.getApplicationContext();
+        final File file = f;
+        worker.execute(() -> buildTrack(app, file));
+    }
+
+    /** What has focus on the home screen: asked every moment by the glow that follows the apps. */
+    interface Focus {
+        HomeApps.Item app();
+    }
+
+    static final class NeonView extends ImageView {
+        private final int mode;
+        private final boolean lightning;
+        private final Handler main = new Handler(Looper.getMainLooper());
+        private ValueAnimator breathe;
+        private boolean running;
+        private File sampled;
+        private Focus focus;
+        private int lastApp;
+        private Track track;
+        private File trackFor;
+        private boolean building;
+        private int lastIndex = -1;
+        private float lastAlpha = -1f;
+        // Lightning: the bolt pictures it flickers between, and a number for the colours they were drawn with
+        private Drawable[] bolts;
+        private int boltAt;
+        private int lastSig;
+        private final java.util.Random rnd = new java.util.Random();
+
+        private final Runnable follower = new Runnable() {
+            @Override public void run() {
+                if (!running) return;
+                if (mode == MODE_APP) {
+                    pollApp();
+                    main.postDelayed(this, 250);
+                } else {
+                    sample();
+                    main.postDelayed(this, FOLLOW_MS);
+                }
+            }
+        };
+
+        /** Lightning: a different picture of the bolts, and a different strength, at uneven moments; a few quick flashes. */
+        private final Runnable flicker = new Runnable() {
+            @Override public void run() {
+                if (!running) return;
+                if (bolts == null || bolts.length == 0) {   // not drawn yet
+                    main.postDelayed(this, 200);
+                    return;
+                }
+                int next = rnd.nextInt(bolts.length);
+                if (next == boltAt && bolts.length > 1) next = (next + 1) % bolts.length;
+                boltAt = next;
+                setImageDrawable(bolts[next]);
+                // Keep spikes readable: never go near invisible on a dim TV.
+                float strength = rnd.nextFloat() < 0.25f ? 0.55f + rnd.nextFloat() * 0.2f : 0.75f + rnd.nextFloat() * 0.25f;
+                setAlpha(Math.round(strength * ALPHA_STEPS) / ALPHA_STEPS);
+                double r = rnd.nextDouble();
+                long delay = r < 0.22 ? 45 + rnd.nextInt(60) : r < 0.6 ? 110 + rnd.nextInt(120) : 260 + rnd.nextInt(520);
+                main.postDelayed(this, delay);
+            }
+        };
+
+        NeonView(Context c, Bitmap bitmap, int mode, boolean lightning) {
+            super(c);
+            this.mode = mode;
+            this.lightning = lightning;
+            if (bitmap != null) setImageBitmap(bitmap);
+            setScaleType(ScaleType.FIT_XY);
+            setFocusable(false);
+            setClickable(false);
+            setImportantForAccessibility(IMPORTANT_FOR_ACCESSIBILITY_NO);
+        }
+
+        /** Lightning: draws the first bolts in the background; they show as soon as they are ready. */
+        void drawLater(final Edges first) {
+            lastSig = signature(first);
+            worker.execute(() -> produce(first, 0, 0));
+        }
+
+        /** Draws the new colours in the background and shows them (see produce). A colour already shown isn't drawn again. */
+        private void show(final Edges e, final int fadeMs, final int cacheKey) {
+            if (lightning) {
+                int sig = signature(e);
+                if (sig == lastSig) return;
+                lastSig = sig;
+            }
+            worker.execute(() -> produce(e, fadeMs, cacheKey));
+        }
+
+        /** On the worker: a glow fades to the new colours; lightning switches to bolts drawn in them. cacheKey: 0 = none. */
+        private void produce(final Edges e, final int fadeMs, final int cacheKey) {
+            if (lightning) {
+                Bitmap[] drawn = cacheKey != 0 ? appBolts.get(cacheKey) : null;
+                if (drawn == null) {
+                    drawn = bolts(e);
+                    if (cacheKey != 0) appBolts.put(cacheKey, drawn);
+                }
+                final Bitmap[] frames = drawn;
+                main.post(() -> setBolts(frames));
+            } else {
+                Bitmap glow = cacheKey != 0 ? appGlows.get(cacheKey) : null;
+                if (glow == null) {
+                    glow = render(e);
+                    if (cacheKey != 0) appGlows.put(cacheKey, glow);
+                }
+                final Bitmap shown = glow;
+                main.post(() -> {
+                    if (running) fadeTo(shown, fadeMs);
+                });
+            }
+        }
+
+        private void setBolts(Bitmap[] frames) {
+            Drawable[] drawables = new Drawable[frames.length];
+            for (int i = 0; i < frames.length; i++) drawables[i] = new BitmapDrawable(getResources(), frames[i]);
+            bolts = drawables;
+            boltAt = Math.min(boltAt, drawables.length - 1);
+            setImageDrawable(drawables[boltAt]);
+        }
+
+        /**
+         * Reads the wallpaper's edges and moves to the new colours: a photo once; a video's colours are read once for
+         * the whole video (in the background), and then the glow just follows the video's position, so the video's
+         * decoder is never opened again while it plays.
+         */
+        private void sample() {
+            final File f = Wallpaper.shownFile();
+            if (f == null) return;   // no wallpaper: it keeps the colours it has
+            if (!Wallpaper.isVideo(f)) {
+                if (f.equals(sampled)) return;
+                sampled = f;
+                worker.execute(() -> {
+                    Bitmap frame = frame(f, false, 0);
+                    if (frame == null) return;
+                    final Edges e = edgesOf(frame);
+                    main.post(() -> {
+                        if (running) show(e, 1100, 0);
+                    });
+                });
+                return;
+            }
+            // Live video wallpaper: NEVER open MediaMetadataRetriever here. Building a colour track while
+            // VideoView plays the same file freezes many Android TVs. Only the disk cache is used; the track
+            // is filled on home pause (preloadTrack) or when the wallpaper is chosen in Settings.
+            Track tr = track;
+            if (tr == null || !f.equals(tr.file)) {
+                Track cached = loadTrackCache(getContext().getApplicationContext(), f);
+                if (cached == null || cached.edges.length == 0) {
+                    // No cache yet: keep the fixed neon colours already on screen. No freeze, no follow until ready.
+                    return;
+                }
+                track = cached;
+                lastIndex = -1;
+                tr = cached;
+            }
+            if (tr.edges.length == 0) return;
+            final int index = tr.indexAt(Wallpaper.videoPositionMs());
+            if (index == lastIndex) return;
+            lastIndex = index;
+            // Cheap update: lightning switches bitmaps; glow cross-fades briefly.
+            show(tr.edges[index], lightning ? 0 : 400, 0);
+        }
+
+        void followApp(Focus f) {
+            focus = f;
+        }
+
+        /** The app with focus has a colour: the glow turns to it (and stays while the focus is elsewhere). */
+        private void pollApp() {
+            int color = Neon.appColor(focus == null ? null : focus.app());
+            if (color == 0 || color == lastApp) return;
+            lastApp = color;
+            show(gradient(new int[] {shift(color, -28f), color, shift(color, 28f)}), 450, color);
+        }
+
+        private void fadeTo(Bitmap glow, int ms) {
+            Drawable previous = getDrawable();
+            if (previous instanceof TransitionDrawable) previous = ((TransitionDrawable) previous).getDrawable(1);   // not a chain
+            if (previous == null) {
+                setImageBitmap(glow);
+                return;
+            }
+            TransitionDrawable t = new TransitionDrawable(new Drawable[] {previous, new BitmapDrawable(getResources(), glow)});
+            t.setCrossFadeEnabled(true);
+            setImageDrawable(t);
+            t.startTransition(ms);
+        }
+
+        /** The breathing (or the flicker of the lightning) and the following of the wallpaper run while the home screen is on. */
+        void run(boolean on) {
+            running = on;
+            if (on) {
+                if (lightning) {
+                    main.removeCallbacks(flicker);
+                    main.post(flicker);
+                } else if (Prefs.lite()) {
+                    // Lite: fixed alpha, no continuous ValueAnimator redraws
+                    setAlpha(0.85f);
+                } else {
+                    if (breathe == null) {
+                        breathe = ValueAnimator.ofFloat(mode != MODE_FIXED ? 0.8f : 0.6f, 1f);
+                        breathe.setDuration(3600);
+                        breathe.setRepeatCount(ValueAnimator.INFINITE);
+                        breathe.setRepeatMode(ValueAnimator.REVERSE);
+                        breathe.setInterpolator(new AccelerateDecelerateInterpolator());
+                        breathe.addUpdateListener(a -> {
+                            float v = Math.round((Float) a.getAnimatedValue() * ALPHA_STEPS) / ALPHA_STEPS;
+                            if (v != lastAlpha) {   // only when the step changes: no redraw for nothing
+                                lastAlpha = v;
+                                setAlpha(v);
+                            }
+                        });
+                    }
+                    if (!breathe.isStarted()) breathe.start();
+                }
+                if (mode != MODE_FIXED) {
+                    sampled = null;   // look again as soon as it is back on screen
+                    lastApp = 0;
+                    lastIndex = -1;
+                    main.removeCallbacks(follower);
+                    main.post(follower);
+                }
+            } else {
+                if (breathe != null) breathe.cancel();
+                main.removeCallbacks(flicker);
+                main.removeCallbacks(follower);
+            }
+        }
+    }
+}
