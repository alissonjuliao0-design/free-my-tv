+        }
+    }
+
+    private static State state(View root) {
+        return root != null && root.getTag() instanceof State ? (State) root.getTag() : null;
+    }
+
+    private static boolean same(File a, File b) {
+        return a == null ? b == null : a.equals(b);
+    }
+
+    /**
+     * What the home screen sits on: the wallpaper (a photo, or a video in a loop) with a shade for the text. It checks
+     * every half minute which one is due (night, the next photo of "My photos"), so the change happens on its own.
+     */
+    static FrameLayout layers(Context c, View home) {
+        final State s = new State();
+        s.app = c.getApplicationContext();
+        FrameLayout root = new FrameLayout(c);
+        root.setTag(s);
+        latestState = s;
+        boolean cinema = Prefs.cinema();
