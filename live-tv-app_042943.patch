--- free-my-tv-orig/app/src/io/freemytv/AppMenu.java	1970-01-01 00:00:00.000000000 +0000
+++ free-my-tv-main/app/src/io/freemytv/AppMenu.java	2026-11-04 07:22:35.305213512 +0000
@@ -0,0 +1,129 @@
+package io.freemytv;
+
+import android.app.Activity;
+import android.app.Dialog;
+import android.graphics.Color;
+import android.graphics.drawable.ColorDrawable;
+import android.graphics.drawable.GradientDrawable;
+import android.graphics.drawable.StateListDrawable;
+import android.view.Gravity;
+import android.view.View;
+import android.view.Window;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+
+/**
+ * Menu when OK is held on an app: on the shelf (move / uninstall), or in All Apps (add or remove from the shelf /
+ * uninstall). Glass panel; arrows walk the rows, OK chooses, Back closes.
+ */
+final class AppMenu {
+    private AppMenu() {}
+
+    /** Which row has the focus when the menu opens again after a move. */
+    static final String LEFT = "left", RIGHT = "right";
+
+    interface Listener {
+        /** -1: one place to the left, 1: one place to the right. */
+        void onMove(int dir);
+
+        void onUninstall();
+
+        /** All Apps: put on the shelf or take it off. */
+        void onToggleShelf();
+    }
+
+    static void show(Activity a, String title, boolean canLeft, boolean canRight, boolean canUninstall,
+                     boolean canToggleShelf, boolean onShelf, String focusId, final Listener listener) {
+        final Dialog dialog = new Dialog(a);
+        dialog.requestWindowFeature(Window.FEATURE_NO_TITLE);
+        final float dp = a.getResources().getDisplayMetrics().density;
+
+        LinearLayout box = new LinearLayout(a);
+        box.setOrientation(LinearLayout.VERTICAL);
+        int pad = (int) (26 * dp);
+        box.setPadding(pad, pad, pad, pad);
+        box.setMinimumWidth((int) (420 * dp));
+        GradientDrawable glass = new GradientDrawable();
+        glass.setColor(0xEB1C1C1E);
+        glass.setCornerRadius(28 * dp);
+        glass.setStroke(Math.max(1, (int) dp), 0x33FFFFFF);
+        box.setBackground(glass);
+
+        TextView head = new TextView(a);
+        head.setText(title == null ? "" : title);
+        head.setTextColor(0xFFFFFFFF);
+        head.setTextSize(24);
+        head.setSingleLine(true);
+        head.setPadding((int) (8 * dp), 0, (int) (8 * dp), (int) (14 * dp));
+        box.addView(head);
+
+        View first = null, wanted = null;
+        if (canLeft) {
+            View v = row(a, dp, Ui.tr("Move left"), () -> {
+                dialog.dismiss();
+                listener.onMove(-1);
+            });
+            box.addView(v);
+            first = v;
+            if (LEFT.equals(focusId)) wanted = v;
+        }
+        if (canRight) {
+            View v = row(a, dp, Ui.tr("Move right"), () -> {
+                dialog.dismiss();
+                listener.onMove(1);
+            });
+            box.addView(v);
+            if (first == null) first = v;
+            if (RIGHT.equals(focusId)) wanted = v;
+        }
+        if (canToggleShelf) {
+            View v = row(a, dp, onShelf ? Ui.tr("Remove from the shelf") : Ui.tr("Add to the shelf"), () -> {
+                dialog.dismiss();
+                listener.onToggleShelf();
+            });
+            box.addView(v);
+            if (first == null) first = v;
+        }
+        if (canUninstall) {
+            View v = row(a, dp, Ui.tr("Uninstall"), () -> {
+                dialog.dismiss();
+                listener.onUninstall();
+            });
+            box.addView(v);
+            if (first == null) first = v;
+        }
+        View cancel = row(a, dp, Ui.tr("Close"), dialog::dismiss);
+        box.addView(cancel);
+        if (first == null) first = cancel;
+
+        dialog.setContentView(box);
+        Window w = dialog.getWindow();
+        if (w != null) {
+            w.setBackgroundDrawable(new ColorDrawable(Color.TRANSPARENT));
+            w.setDimAmount(0.5f);
+            w.setGravity(Gravity.CENTER);
+        }
+        (wanted != null ? wanted : first).requestFocus();
+        dialog.show();
+    }
+
+    private static View row(Activity a, float dp, String text, final Runnable click) {
+        TextView v = new TextView(a);
+        v.setText(text);
+        v.setTextColor(0xFFFFFFFF);
+        v.setTextSize(21);
+        v.setPadding((int) (22 * dp), (int) (14 * dp), (int) (22 * dp), (int) (14 * dp));
+        v.setFocusable(true);
+        v.setClickable(true);
+        GradientDrawable on = new GradientDrawable();
+        on.setColor(0x40FFFFFF);
+        on.setCornerRadius(16 * dp);
+        StateListDrawable look = new StateListDrawable();
+        look.addState(new int[] {android.R.attr.state_focused}, on);
+        look.addState(new int[] {android.R.attr.state_pressed}, on);
+        look.addState(new int[] {}, new ColorDrawable(Color.TRANSPARENT));
+        v.setBackground(look);
+        v.setOnClickListener(x -> click.run());
+        return v;
+    }
+}
