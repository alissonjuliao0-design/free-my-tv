--- free-my-tv-orig/app/src/io/freemytv/CinemaOverlay.java	1970-01-01 00:00:00.000000000 +0000
+++ free-my-tv-main/app/src/io/freemytv/CinemaOverlay.java	2026-11-04 07:22:35.305213512 +0000
@@ -0,0 +1,173 @@
+package io.freemytv;
+
+import android.app.Notification;
+import android.app.NotificationChannel;
+import android.app.NotificationManager;
+import android.app.Service;
+import android.content.Context;
+import android.content.Intent;
+import android.graphics.PixelFormat;
+import android.os.Build;
+import android.os.Handler;
+import android.os.IBinder;
+import android.os.Looper;
+import android.provider.Settings;
+import android.view.Gravity;
+import android.view.View;
+import android.view.WindowManager;
+import android.widget.Toast;
+
+/**
+ * Cinema mode over other apps: a soft black veil on top of whatever is open (Netflix, YouTube, Live TV…), so the room
+ * stays dim the same way the home screen does. The home screen itself already dims its own wallpaper; this only runs
+ * while Free My TV is in the background and Cinema mode is on. Uses the same overlay permission as the sleep timer
+ * (granted through ADB in Free My TV mode on Android TV).
+ */
+public class CinemaOverlay extends Service {
+    private static final String CH = "cinema";
+    private View veil;
+    private static final Handler main = new Handler(Looper.getMainLooper());
+
+    /**
+     * Show or hide the veil. {@code homeInFront}: the home screen is visible — never cover it.
+     * Call from HomeActivity onResume/onPause and when Cinema is toggled in the gear panel.
+     */
+    static void update(Context c, boolean homeInFront) {
+        Intent i = new Intent(c, CinemaOverlay.class);
+        boolean wanted = Prefs.cinema() && !homeInFront;
+        if (wanted && Settings.canDrawOverlays(c)) {
+            try {
+                if (Build.VERSION.SDK_INT >= 26) c.startForegroundService(i);
+                else c.startService(i);
+            } catch (RuntimeException e) {
+                AppLog.w("cinema overlay start: " + e.getMessage());
+            }
+            return;
+        }
+        try {
+            c.stopService(i);
+        } catch (RuntimeException ignored) {
+        }
+        // Need the veil but no permission yet: ask ADB (Free My TV mode), same path as the sleep timer.
+        if (wanted) {
+            if (Capabilities.overlay(c) || Capabilities.adb(c)) {
+                allow(c.getApplicationContext());
+            } else {
+                AppLog.w("cinema overlay: no SYSTEM_ALERT_WINDOW and no ADB");
+            }
+        }
+    }
+
+    /** Turn Cinema on and make sure the overlay path is ready (permission + service when home leaves). */
+    static void onCinemaToggled(Context c) {
+        if (!Prefs.cinema()) {
+            update(c, true);   // off: drop any veil
+            return;
+        }
+        if (!Settings.canDrawOverlays(c)) {
+            allow(c.getApplicationContext());
+            main.post(() -> Toast.makeText(c.getApplicationContext(),
+                    Ui.tr("Cinema over other apps needs overlay permission (Free My TV mode / ADB)."),
+                    Toast.LENGTH_LONG).show());
+        }
+        // Home is usually still in front after the gear panel; the veil starts on the next onPause.
+        update(c, true);
+    }
+
+    private static final java.util.concurrent.atomic.AtomicBoolean allowing =
+            new java.util.concurrent.atomic.AtomicBoolean();
+
+    private static void allow(Context c) {
+        if (!allowing.compareAndSet(false, true)) return;
+        new Thread(() -> {
+            try (Adb adb = Adb.connect(c, 10_000, null)) {
+                adb.shell("appops set " + HomeMode.PKG + " SYSTEM_ALERT_WINDOW allow");
+            } catch (java.io.IOException e) {
+                AppLog.w("cinema overlay allow: " + e.getMessage());
+                allowing.set(false);
+                return;
+            }
+            boolean works = Settings.canDrawOverlays(c);
+            for (int i = 0; i < 8 && !works; i++) {
+                android.os.SystemClock.sleep(250);
+                works = Settings.canDrawOverlays(c);
+            }
+            Capabilities.prove(c, Capabilities.OVERLAY, works);
+            allowing.set(false);
+            AppLog.w("cinema overlay permission: " + works);
+            // Do not show the veil while home is in front; next onPause will start it.
+        }).start();
+    }
+
+    @Override public void onCreate() {
+        super.onCreate();
+        if (Build.VERSION.SDK_INT >= 26) {
+            NotificationChannel ch = new NotificationChannel(CH, "Cinema mode", NotificationManager.IMPORTANCE_MIN);
+            ch.setShowBadge(false);
+            ch.setSound(null, null);
+            getSystemService(NotificationManager.class).createNotificationChannel(ch);
+            Notification n = new Notification.Builder(this, CH)
+                    .setContentTitle("Cinema mode")
+                    .setContentText("Dimmed over other apps")
+                    .setSmallIcon(R.drawable.icon)
+                    .setOngoing(true)
+                    .build();
+            startForeground(72, n);
+        }
+        if (!Settings.canDrawOverlays(this)) {
+            AppLog.w("cinema overlay: no permission in onCreate");
+            stopSelf();
+            return;
+        }
+        veil = new View(this);
+        // Same depth of shade the home screen uses in Cinema mode (~72% black).
+        veil.setBackgroundColor(0xB8000000);
+        int type = Build.VERSION.SDK_INT >= 26
+                ? WindowManager.LayoutParams.TYPE_APPLICATION_OVERLAY
+                : WindowManager.LayoutParams.TYPE_SYSTEM_ALERT;
+        WindowManager.LayoutParams lp = new WindowManager.LayoutParams(
+                WindowManager.LayoutParams.MATCH_PARENT,
+                WindowManager.LayoutParams.MATCH_PARENT,
+                type,
+                WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE
+                        | WindowManager.LayoutParams.FLAG_NOT_TOUCHABLE
+                        | WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN
+                        | WindowManager.LayoutParams.FLAG_LAYOUT_NO_LIMITS
+                        | WindowManager.LayoutParams.FLAG_HARDWARE_ACCELERATED,
+                PixelFormat.TRANSLUCENT);
+        lp.gravity = Gravity.TOP | Gravity.START;
+        lp.width = WindowManager.LayoutParams.MATCH_PARENT;
+        lp.height = WindowManager.LayoutParams.MATCH_PARENT;
+        try {
+            getSystemService(WindowManager.class).addView(veil, lp);
+            AppLog.w("cinema overlay: veil added");
+        } catch (RuntimeException e) {
+            AppLog.w("cinema overlay add: " + e.getMessage());
+            stopSelf();
+        }
+    }
+
+    @Override public int onStartCommand(Intent intent, int flags, int startId) {
+        if (!Prefs.cinema() || !Settings.canDrawOverlays(this)) {
+            stopSelf();
+            return START_NOT_STICKY;
+        }
+        return START_STICKY;
+    }
+
+    @Override public void onDestroy() {
+        if (veil != null) {
+            try {
+                getSystemService(WindowManager.class).removeView(veil);
+            } catch (RuntimeException ignored) {
+            }
+            veil = null;
+        }
+        AppLog.w("cinema overlay: destroyed");
+        super.onDestroy();
+    }
+
+    @Override public IBinder onBind(Intent intent) {
+        return null;
+    }
+}
diff -ruN '--exclude=FreeMyTV.apk' '--exclude=*.idsig' '--exclude=.git' '--exclude=out' '--exclude=*.class' '--exclude=*.keystore' free-my-tv-orig/app/src/io/freemytv/CustomKeys.java free-my-tv-main/app/src/io/freemytv/CustomKeys.java
--- free-my-tv-orig/app/src/io/freemytv/CustomKeys.java	1970-01-01 00:00:00.000000000 +0000
+++ free-my-tv-main/app/src/io/freemytv/CustomKeys.java	2026-11-04 07:22:35.305213512 +0000
@@ -0,0 +1,249 @@
+package io.freemytv;
+
+import android.content.Context;
+import android.content.Intent;
+import android.content.pm.PackageManager;
+import android.provider.Settings;
+import android.view.InputDevice;
+import android.view.KeyEvent;
+
+import java.io.BufferedReader;
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.InputStreamReader;
+import java.nio.charset.StandardCharsets;
+import java.util.Arrays;
+
+/**
+ * Your own remote buttons (Home Settings > Custom button 1 to 4): any button of any remote can open any app. You press
+ * "learn", then the button on the remote, and pick the app. Read by the key service (RemoteKeyService), which runs in a
+ * process of its own, so the choices live in a tiny file both processes read, and this class stays small.
+ */
+final class CustomKeys {
+    private CustomKeys() {}
+
+    static final int SLOTS = 4;
+    private static final long LEARN_MS = 30_000;
+    private static final String FILE = "custom-keys.txt", LEARN = "custom-learn.txt";
+
+    private static final int[] codes = new int[SLOTS];
+    private static final String[] pkgs = new String[SLOTS];
+    private static long stamp = Long.MIN_VALUE;
+    /** The key just learned: its key-up is ours too, or the TV would get a key-up with no key-down. */
+    private static int learnedDown;
+
+    private static File file(Context c) {
+        return new File(c.getFilesDir(), FILE);
+    }
+
+    private static File learnFile(Context c) {
+        return new File(c.getFilesDir(), LEARN);
+    }
+
+    /** True once a button was ever set: the key service then stays in step with the choices (on, or off when none is left). */
+    static boolean touched(Context c) {
+        return file(c).exists();
+    }
+
+    /** Reads the file again only when it changed. */
+    private static synchronized void load(Context c) {
+        File f = file(c);
+        long now = f.exists() ? f.lastModified() * 31 + f.length() : -1;
+        if (now == stamp) return;
+        stamp = now;
+        Arrays.fill(codes, 0);
+        Arrays.fill(pkgs, "");
+        if (now == -1) return;
+        try (BufferedReader r = new BufferedReader(new InputStreamReader(new FileInputStream(f), StandardCharsets.UTF_8))) {
+            String line;
+            while ((line = r.readLine()) != null) {   // slot=code|package
+                int eq = line.indexOf('='), bar = line.indexOf('|');
+                if (eq < 1 || bar < eq) continue;
+                try {
+                    int slot = Integer.parseInt(line.substring(0, eq));
+                    if (slot < 0 || slot >= SLOTS) continue;
+                    codes[slot] = Integer.parseInt(line.substring(eq + 1, bar));
+                    pkgs[slot] = line.substring(bar + 1).trim();
+                } catch (NumberFormatException ignored) {
+                }
+            }
+        } catch (IOException ignored) {
+        }
+    }
+
+    private static synchronized void save(Context c) {
+        StringBuilder sb = new StringBuilder();
+        for (int i = 0; i < SLOTS; i++) sb.append(i).append('=').append(codes[i]).append('|').append(pkgs[i]).append('\n');
+        File tmp = new File(c.getFilesDir(), "custom-keys." + android.os.Process.myPid() + ".tmp");
+        try (FileOutputStream out = new FileOutputStream(tmp)) {
+            out.write(sb.toString().getBytes(StandardCharsets.UTF_8));
+            out.getFD().sync();
+        } catch (IOException e) {
+            //noinspection ResultOfMethodCallIgnored
+            tmp.delete();
+            return;
+        }
+        if (tmp.renameTo(file(c))) stamp = Long.MIN_VALUE;   // read again, whoever wrote it
+    }
+
+    static synchronized int code(Context c, int slot) {
+        load(c);
+        return codes[slot];
+    }
+
+    /** The app (or "All Apps", or the quick panel) the button opens; "" for nothing. */
+    static synchronized String pkg(Context c, int slot) {
+        load(c);
+        return pkgs[slot];
+    }
+
+    static synchronized void setApp(Context c, int slot, String pkg) {
+        load(c);
+        pkgs[slot] = pkg == null ? "" : pkg;
+        save(c);
+    }
+
+    /** A button learned: it goes to this slot (and leaves any other that had it). The app stays as it was. */
+    private static synchronized void setKey(Context c, int slot, int code) {
+        load(c);
+        for (int i = 0; i < SLOTS; i++) {
+            if (i != slot && codes[i] == code) {
+                codes[i] = 0;
+                pkgs[i] = "";
+            }
+        }
+        codes[slot] = code;
+        save(c);
+    }
+
+    static synchronized void clear(Context c, int slot) {
+        load(c);
+        codes[slot] = 0;
+        pkgs[slot] = "";
+        save(c);
+    }
+
+    // MARK: - Learning
+
+    static void startLearning(Context c, int slot) {
+        try (FileOutputStream out = new FileOutputStream(learnFile(c))) {
+            out.write((slot + "|" + System.currentTimeMillis()).getBytes(StandardCharsets.UTF_8));
+        } catch (IOException e) {
+            AppLog.w("custom button: " + e.getMessage());
+        }
+    }
+
+    static void stopLearning(Context c) {
+        //noinspection ResultOfMethodCallIgnored
+        learnFile(c).delete();
+    }
+
+    /** The slot waiting for a button press (for 30 seconds), or -1. */
+    static int learningSlot(Context c) {
+        File f = learnFile(c);
+        if (!f.exists()) return -1;
+        try (BufferedReader r = new BufferedReader(new InputStreamReader(new FileInputStream(f), StandardCharsets.UTF_8))) {
+            String line = r.readLine();
+            if (line == null) return -1;
+            int bar = line.indexOf('|');
+            long at = Long.parseLong(line.substring(bar + 1).trim());
+            long age = System.currentTimeMillis() - at;
+            if (age < 0 || age > LEARN_MS) return -1;
+            return Integer.parseInt(line.substring(0, bar));
+        } catch (IOException | RuntimeException e) {
+            return -1;
+        }
+    }
+
+    /** The key service has work: a button opens something, or one is being learned. */
+    static boolean wanted(Context c) {
+        if (learningSlot(c) >= 0) return true;
+        load(c);
+        for (int i = 0; i < SLOTS; i++) if (codes[i] != 0 && !pkgs[i].isEmpty()) return true;
+        return false;
+    }
+
+    /** Whether the key service is switched on in the TV's accessibility settings. */
+    static boolean serviceOn(Context c) {
+        String on = Settings.Secure.getString(c.getContentResolver(), Settings.Secure.ENABLED_ACCESSIBILITY_SERVICES);
+        return on != null && on.contains(HomeMode.PKG + "/" + HomeMode.PKG + ".RemoteKeyService");
+    }
+
+    /** Buttons that can't be learned: moving around, Back, Home, the volume and the power keys. */
+    private static boolean reserved(int code) {
+        switch (code) {
+            case KeyEvent.KEYCODE_UNKNOWN:
+            case KeyEvent.KEYCODE_DPAD_UP:
+            case KeyEvent.KEYCODE_DPAD_DOWN:
+            case KeyEvent.KEYCODE_DPAD_LEFT:
+            case KeyEvent.KEYCODE_DPAD_RIGHT:
+            case KeyEvent.KEYCODE_DPAD_CENTER:
+            case KeyEvent.KEYCODE_ENTER:
+            case KeyEvent.KEYCODE_BACK:
+            case KeyEvent.KEYCODE_HOME:
+            case KeyEvent.KEYCODE_ESCAPE:
+            case KeyEvent.KEYCODE_VOLUME_UP:
+            case KeyEvent.KEYCODE_VOLUME_DOWN:
+            case KeyEvent.KEYCODE_VOLUME_MUTE:
+            case KeyEvent.KEYCODE_POWER:
+            case KeyEvent.KEYCODE_TV_POWER:
+            case KeyEvent.KEYCODE_SLEEP:
+            case KeyEvent.KEYCODE_WAKEUP:
+                return true;
+            default:
+                return false;
+        }
+    }
+
+    // MARK: - The keys
+
+    /** True when the key is one of ours (a button being learned, or one that opens an app): it never reaches the TV. */
+    static boolean onKey(Context c, KeyEvent e) {
+        int source = e.getSource();
+        if ((source & InputDevice.SOURCE_GAMEPAD) == InputDevice.SOURCE_GAMEPAD
+                || (source & InputDevice.SOURCE_JOYSTICK) == InputDevice.SOURCE_JOYSTICK) return false;
+        int code = e.getKeyCode();
+        boolean down = e.getAction() == KeyEvent.ACTION_DOWN;
+        if (!down && code == learnedDown) {
+            learnedDown = 0;
+            return true;
+        }
+        int learning = learnFile(c).exists() ? learningSlot(c) : -1;
+        if (learning >= 0 && down && !reserved(code)) {
+            setKey(c, learning, code);
+            stopLearning(c);
+            learnedDown = code;
+            return true;
+        }
+        String pkg = "";
+        synchronized (CustomKeys.class) {
+            load(c);
+            for (int i = 0; i < SLOTS; i++) if (codes[i] == code && !pkgs[i].isEmpty()) pkg = pkgs[i];
+        }
+        if (pkg.isEmpty()) return false;
+        if (down && e.getRepeatCount() == 0) open(c, pkg);
+        return true;
+    }
+
+    private static void open(Context c, String pkg) {
+        Intent intent;
+        if (pkg.equals(Prefs.ALL_APPS)) {
