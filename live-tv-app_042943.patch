+    }
+
+    private static File resolve(Context c, String value) {
+        if (value.isEmpty() || value.equals(ASK)) return null;
+        if (value.equals(ROTATE)) {
+            List<File> photos = Photos.files(c);
+            if (photos.isEmpty()) return null;
+            long slot = System.currentTimeMillis() / (Prefs.wallpaperMinutes() * 60_000L);
+            return photos.get((int) (slot % photos.size()));
+        }
+        File f = new File(value);
+        if (!f.isFile()) return null;
+        return own(c, f) || allowed(c) ? f : null;
+    }
+
+    /** Before the home screen reads day or night: on a wallpaper, or in Cinema mode, it leaves its own background out. */
+    static void prepare(Context c) {
