+package io.freemytv;
+
+import android.Manifest;
+import android.app.Activity;
+import android.content.Context;
+import android.content.pm.PackageManager;
+import android.graphics.Bitmap;
+import android.graphics.BitmapFactory;
+import android.graphics.Color;
+import android.graphics.drawable.GradientDrawable;
+import android.os.Build;
+import android.os.Environment;
+import android.os.Handler;
+import android.os.Looper;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.FrameLayout;
+import android.widget.ImageView;
+import android.widget.VideoView;
+
+import java.io.File;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import java.util.Locale;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+
+/**
+ * Your own wallpaper behind the home screen (Home Settings > Wallpaper): a sharp photo, or a video that plays in a
+ * loop with no sound. Android TV has no live wallpapers of its own, so this lives inside Free My TV only.
+ *
+ * The files are the ones in a folder called "FreeMyTV" on the TV's storage or on a USB drive (Pictures, Movies, DCIM,
+ * Download, or the drive's root): put them there with Send Files to TV, a USB stick or any file manager.
+ */
+final class Wallpaper {
+    private Wallpaper() {}
+
+    /** A wallpaper is chosen and on screen: the home screen leaves its own background out and takes the night look. */
+    static volatile boolean active;
+
+    private static final String FOLDER = "FreeMyTV";
+    private static final String[] IMAGES = {"jpg", "jpeg", "png", "webp"};
+    private static final String[] VIDEOS = {"mp4", "webm", "mkv", "3gp"};
+    private static final ExecutorService worker = Executors.newSingleThreadExecutor();
+    private static final Handler main = new Handler(Looper.getMainLooper());
+
+    // MARK: - Permission
+
+    static boolean allowed(Context c) {
+        String p = Build.VERSION.SDK_INT >= 33 ? Manifest.permission.READ_MEDIA_IMAGES : Manifest.permission.READ_EXTERNAL_STORAGE;
+        return c.checkSelfPermission(p) == PackageManager.PERMISSION_GRANTED;
+    }
+
+    static void request(Activity a) {
+        if (Build.VERSION.SDK_INT >= 33) {
+            a.requestPermissions(new String[] {Manifest.permission.READ_MEDIA_IMAGES, Manifest.permission.READ_MEDIA_VIDEO}, 71);
+        } else {
+            a.requestPermissions(new String[] {Manifest.permission.READ_EXTERNAL_STORAGE}, 71);
+        }
+    }
+
+    // MARK: - The files
+
+    private static boolean has(String name, String[] extensions) {
+        String n = name.toLowerCase(Locale.ROOT);
+        for (String e : extensions) if (n.endsWith("." + e)) return true;
+        return false;
+    }
+
+    static boolean isVideo(File f) {
+        return has(f.getName(), VIDEOS);
+    }
+
+    /** Every photo and video in a "FreeMyTV" folder, by name. Empty without the storage permission. */
+    static List<File> files(Context c) {
+        List<File> out = new ArrayList<>();
+        if (!allowed(c)) return out;
+        List<File> roots = new ArrayList<>();
+        for (String type : new String[] {Environment.DIRECTORY_PICTURES, Environment.DIRECTORY_MOVIES,
+                Environment.DIRECTORY_DCIM, Environment.DIRECTORY_DOWNLOADS}) {
+            roots.add(new File(Environment.getExternalStoragePublicDirectory(type), FOLDER));
+        }
+        roots.add(new File(Environment.getExternalStorageDirectory(), FOLDER));
+        File[] volumes = new File("/storage").listFiles();   // USB drives and SD cards
+        if (volumes != null) {
+            for (File v : volumes) {
+                if (v.getName().equals("self") || v.getName().equals("emulated")) continue;
+                roots.add(new File(v, FOLDER));
+            }
+        }
+        for (File root : roots) {
+            File[] list = root.listFiles();
+            if (list == null) continue;
+            for (File f : list) {
+                if (f.isFile() && (has(f.getName(), IMAGES) || has(f.getName(), VIDEOS)) && !out.contains(f)) out.add(f);
+            }
+        }
+        Collections.sort(out, (a, b) -> a.getName().compareToIgnoreCase(b.getName()));
+        return out;
+    }
+
+    /** The chosen file, or null (none chosen, moved away, or no permission). */
+    static File chosen(Context c) {
+        String path = Prefs.wallpaper();
+        if (path.isEmpty() || !allowed(c)) return null;
+        File f = new File(path);
+        return f.isFile() ? f : null;
+    }
+
+    // MARK: - On screen
+
+    /** What the home screen sits on: the wallpaper (and a light shade for the text), or null when there is none. */
+    static FrameLayout layers(Context c, View home) {
+        FrameLayout root = new FrameLayout(c);
+        File file = chosen(c);
+        active = file != null;
+        if (file != null) {
+            root.setBackgroundColor(Color.BLACK);
+            if (isVideo(file)) {
+                final VideoView video = new VideoView(c);
+                video.setOnPreparedListener(mp -> {
+                    mp.setLooping(true);
+                    mp.setVolume(0, 0);
+                    video.start();
+                });
+                video.setOnErrorListener((mp, what, extra) -> {
+                    AppLog.w("wallpaper video: " + what + "/" + extra);
+                    return true;
+                });
+                video.setVideoPath(file.getPath());
+                root.addView(video, fill());
+                root.setTag(video);
+            } else {
+                final ImageView image = new ImageView(c);
+                image.setScaleType(ImageView.ScaleType.CENTER_CROP);
+                root.addView(image, fill());
+                final int width = Math.max(1280, Math.min(3840, c.getResources().getDisplayMetrics().widthPixels));
+                worker.execute(() -> {
+                    Bitmap bitmap = decode(file, width);
+                    if (bitmap != null) main.post(() -> image.setImageBitmap(bitmap));
+                });
+            }
+            // A soft shade at the top and bottom keeps the clock, the buttons and the shelf readable on any picture.
+            View shade = new View(c);
+            GradientDrawable g = new GradientDrawable(GradientDrawable.Orientation.TOP_BOTTOM,
+                    new int[] {0x73000000, 0x14000000, 0x00000000, 0x59000000, 0xA6000000});
+            shade.setBackground(g);
+            root.addView(shade, fill());
+        }
+        root.addView(home, fill());
+        return root;
+    }
+
+    private static ViewGroup.LayoutParams fill() {
+        return new FrameLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT);
+    }
+
+    /** Pauses and resumes a video wallpaper with the screen. */
+    static void pause(View root) {
+        if (root != null && root.getTag() instanceof VideoView) ((VideoView) root.getTag()).pause();
+    }
+
+    static void resume(View root) {
+        if (root != null && root.getTag() instanceof VideoView) ((VideoView) root.getTag()).start();
+    }
+
+    static void release(View root) {
+        if (root != null && root.getTag() instanceof VideoView) ((VideoView) root.getTag()).stopPlayback();
+        active = false;
+    }
+
+    /** A photo at the screen's size, never bigger (sharp, not blurred, and light on memory). */
+    private static Bitmap decode(File f, int wantedWidth) {
+        try {
+            BitmapFactory.Options o = new BitmapFactory.Options();
+            o.inJustDecodeBounds = true;
+            BitmapFactory.decodeFile(f.getPath(), o);
+            int sample = 1;
+            while (o.outWidth / (sample * 2) >= wantedWidth) sample *= 2;
+            o = new BitmapFactory.Options();
+            o.inSampleSize = sample;
+            return BitmapFactory.decodeFile(f.getPath(), o);
+        } catch (RuntimeException | OutOfMemoryError e) {
+            AppLog.w("wallpaper photo: " + e.getMessage());
+            return null;
+        }
+    }
+}
