+        /** The Live TV app row: the pinned app's name, or "TV's own" while none is pinned (or it was uninstalled). */
+        private String liveAppLabel() {
+            String pkg = Prefs.liveApp();
+            if (pkg.isEmpty()) return Ui.tr("TV's own");
+            for (String[] app : HomeApps.launchable(getContext())) if (app[0].equals(pkg)) return app[1];
+            return Ui.tr("TV's own");
+        }
+
+        /** ← → on the Live TV app row: "TV's own", then every installed app by name; the Live TV button opens it. */
+        private void stepLiveApp(int dir) {
+            List<String[]> found = new ArrayList<>();
+            for (String[] app : HomeApps.launchable(getContext())) {
+                if (!app[0].equals(getContext().getPackageName())) found.add(app);
+            }
+            Collections.sort(found, (a, b) -> a[1].toLowerCase(Locale.ROOT).compareTo(b[1].toLowerCase(Locale.ROOT)));
+            List<String> pkgs = new ArrayList<>();
+            pkgs.add("");
+            for (String[] f : found) pkgs.add(f[0]);
+            int at = Math.max(0, pkgs.indexOf(Prefs.liveApp()));
+            Prefs.setLiveApp(pkgs.get((at + dir + pkgs.size()) % pkgs.size()));
+        }
