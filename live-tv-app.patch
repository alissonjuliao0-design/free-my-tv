+import android.widget.FrameLayout;
+import android.widget.ImageView;
+import android.widget.VideoView;
+
+import java.io.File;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import java.util.Locale;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+
+/**
+ * Your own wallpaper behind the home screen (Home Settings > Wallpaper): a sharp photo, or a video that plays in a
+ * loop with no sound. Android TV has no live wallpapers of its own, so this lives inside Free My TV only.
+ *
+ * Where they come from: the photos you already sent to Free My TV ("My photos", one for each hour or one you pick),
+ * the app's own wallpaper folder (Android/data/io.freemytv/files/wallpaper, no permission needed), and a folder called
+ * "FreeMyTV" on the TV's storage or on a USB drive (Pictures, Movies, DCIM, Download, or the drive's root), which asks
+ * for the storage permission once.
+ */
+final class Wallpaper {
+    private Wallpaper() {}
+
+    /** A wallpaper is chosen and on screen: the home screen leaves its own background out and takes the night look. */
+    static volatile boolean active;
+
+    /** The Wallpaper row's "My photos, a different one each hour" and the "allow storage access" step. */
+    static final String ROTATE = "photos:rotate", ASK = "ask:storage";
+    private static final String FOLDER = "FreeMyTV";
+    private static final String[] IMAGES = {"jpg", "jpeg", "png", "webp"};
+    private static final String[] VIDEOS = {"mp4", "webm", "mkv", "3gp"};
+    private static final ExecutorService worker = Executors.newSingleThreadExecutor();
+    private static final Handler main = new Handler(Looper.getMainLooper());
+
+    // MARK: - Permission
+
+    static boolean allowed(Context c) {
+        String p = Build.VERSION.SDK_INT >= 33 ? Manifest.permission.READ_MEDIA_IMAGES : Manifest.permission.READ_EXTERNAL_STORAGE;
+        return c.checkSelfPermission(p) == PackageManager.PERMISSION_GRANTED;
+    }
+
+    static void request(Activity a) {
+        if (Build.VERSION.SDK_INT >= 33) {
+            a.requestPermissions(new String[] {Manifest.permission.READ_MEDIA_IMAGES, Manifest.permission.READ_MEDIA_VIDEO}, 71);
+        } else {
+            a.requestPermissions(new String[] {Manifest.permission.READ_EXTERNAL_STORAGE}, 71);
+        }
+    }
+
+    // MARK: - The files
+
+    private static boolean has(String name, String[] extensions) {
+        String n = name.toLowerCase(Locale.ROOT);
+        for (String e : extensions) if (n.endsWith("." + e)) return true;
+        return false;
+    }
+
+    static boolean isVideo(File f) {
+        return has(f.getName(), VIDEOS);
+    }
+
+    /** The app's own folder for wallpapers: the TV lets the app read it without asking. */
+    private static File ownFolder(Context c) {
+        return c.getExternalFilesDir("wallpaper");
+    }
+
+    private static boolean own(Context c, File f) {
+        String p = f.getPath();
+        File ext = c.getExternalFilesDir(null);
+        return p.startsWith(c.getFilesDir().getPath()) || ext != null && p.startsWith(ext.getPath());
+    }
+
+    /** Every photo and video in the app's wallpaper folder and, with the permission, in the "FreeMyTV" folders, by name. */
+    static List<File> files(Context c) {
+        List<File> out = new ArrayList<>();
+        List<File> roots = new ArrayList<>();
+        File mine = ownFolder(c);
+        if (mine != null) {
+            //noinspection ResultOfMethodCallIgnored
+            mine.mkdirs();
+            roots.add(mine);
+        }
+        if (allowed(c)) {
+            for (String type : new String[] {Environment.DIRECTORY_PICTURES, Environment.DIRECTORY_MOVIES,
+                    Environment.DIRECTORY_DCIM, Environment.DIRECTORY_DOWNLOADS}) {
+                roots.add(new File(Environment.getExternalStoragePublicDirectory(type), FOLDER));
+            }
+            roots.add(new File(Environment.getExternalStorageDirectory(), FOLDER));
+            File[] volumes = new File("/storage").listFiles();   // USB drives and SD cards
+            if (volumes != null) {
+                for (File v : volumes) {
+                    if (v.getName().equals("self") || v.getName().equals("emulated")) continue;
+                    roots.add(new File(v, FOLDER));
+                }
+            }
+        }
+        for (File root : roots) {
+            File[] list = root.listFiles();
+            if (list == null) continue;
+            for (File f : list) {
+                if (f.isFile() && (has(f.getName(), IMAGES) || has(f.getName(), VIDEOS)) && !out.contains(f)) out.add(f);
+            }
+        }
+        Collections.sort(out, (a, b) -> a.getName().compareToIgnoreCase(b.getName()));
+        return out;
+    }
+
+    /** What the Wallpaper row steps through: Off, "My photos", each of them, the files, and the permission step. */
+    static List<String> choices(Context c) {
+        List<String> out = new ArrayList<>();
+        out.add("");
+        List<File> photos = Photos.files(c);
+        if (!photos.isEmpty()) out.add(ROTATE);
+        for (File f : photos) out.add(f.getPath());
+        for (File f : files(c)) out.add(f.getPath());
+        if (!allowed(c)) out.add(ASK);
+        return out;
+    }
+
+    /** The name the Wallpaper row shows for a choice. */
+    static String label(Context c, String value) {
+        if (value.isEmpty()) return Ui.tr("Off");
+        if (value.equals(ROTATE)) return Ui.tr("My photos (a new one each hour)");
+        if (value.equals(ASK)) return Ui.tr("Allow storage access (press →)");
+        List<File> photos = Photos.files(c);
+        for (int i = 0; i < photos.size(); i++) {
+            if (photos.get(i).getPath().equals(value)) return Ui.tr("My photo") + " " + (i + 1);
+        }
+        File f = new File(value);
+        return f.isFile() ? f.getName() : Ui.tr("Off");
+    }
+
+    // MARK: - What is chosen now
+
+    /** From 18:00 to 06:00 on the device's clock. */
+    private static boolean nightNow() {
+        int h = java.util.Calendar.getInstance().get(java.util.Calendar.HOUR_OF_DAY);
+        return h >= 18 || h < 6;
+    }
+
+    /** The file for this moment: the night's choice after dark (when there is one), else the day's. Null: none. */
+    static File chosen(Context c) {
+        String night = Prefs.wallpaperNight();
+        return resolve(c, nightNow() && !night.isEmpty() ? night : Prefs.wallpaper());
+    }
+
+    private static File resolve(Context c, String value) {
+        if (value.isEmpty() || value.equals(ASK)) return null;
+        if (value.equals(ROTATE)) {
+            List<File> photos = Photos.files(c);
+            if (photos.isEmpty()) return null;
+            long slot = System.currentTimeMillis() / (Prefs.wallpaperMinutes() * 60_000L);
+            return photos.get((int) (slot % photos.size()));
+        }
+        File f = new File(value);
+        if (!f.isFile()) return null;
+        return own(c, f) || allowed(c) ? f : null;
+    }
+
+    /** Before the home screen reads day or night: on a wallpaper, or in Cinema mode, it leaves its own background out. */
+    static void prepare(Context c) {
+        active = chosen(c) != null || Prefs.cinema();
+    }
+
+    // MARK: - On screen
+
+    private static final class State {
+        Context app;
+        ImageView image;
+        VideoView video;
+        View shade;
+        File shown;
+        Runnable tick;
+        boolean released;
+    }
+
+    /** The wallpaper on screen now, for the neon that follows it. */
+    private static State latestState;
+
+    /** The photo or video on screen now, or null. */
+    static File shownFile() {
+        State s = latestState;
+        return s == null ? null : s.shown;
+    }
+
+    /** How far the video wallpaper has played (ms), 0 for a photo. */
+    static int videoPositionMs() {
+        State s = latestState;
+        if (s == null || s.video == null) return 0;
+        try {
+            return s.video.getCurrentPosition();
+        } catch (RuntimeException e) {
+            return 0;
+        }
+    }
+
+    private static State state(View root) {
+        return root != null && root.getTag() instanceof State ? (State) root.getTag() : null;
+    }
+
+    private static boolean same(File a, File b) {
+        return a == null ? b == null : a.equals(b);
+    }
+
+    /**
+     * What the home screen sits on: the wallpaper (a photo, or a video in a loop) with a shade for the text. It checks
+     * every half minute which one is due (night, the next photo of "My photos"), so the change happens on its own.
+     */
+    static FrameLayout layers(Context c, View home) {
+        final State s = new State();
+        s.app = c.getApplicationContext();
+        FrameLayout root = new FrameLayout(c);
+        root.setTag(s);
+        latestState = s;
+        boolean cinema = Prefs.cinema();
+        boolean any = cinema || !Prefs.wallpaper().isEmpty() || !Prefs.wallpaperNight().isEmpty();
+        if (any) {
+            root.setBackgroundColor(Color.BLACK);
+            s.image = new ImageView(c);
+            s.image.setScaleType(ImageView.ScaleType.CENTER_CROP);
+            s.image.setVisibility(View.GONE);
+            root.addView(s.image, fill());
+            final VideoView video = new VideoView(c);
+            video.setOnPreparedListener(mp -> {
+                mp.setLooping(true);
+                mp.setVolume(0, 0);
+                video.start();
+            });
+            video.setOnErrorListener((mp, what, extra) -> {
+                AppLog.w("wallpaper video: " + what + "/" + extra);
+                return true;
+            });
+            video.setVisibility(View.GONE);
+            s.video = video;
+            root.addView(video, fill());
+            // A soft shade at the top and bottom keeps the clock, the buttons and the shelf readable on any picture;
+            // in Cinema mode it is a deep, even one.
+            s.shade = new View(c);
+            int[] colors = cinema ? new int[] {0xB8000000, 0xB8000000}
+                    : new int[] {0x73000000, 0x14000000, 0x00000000, 0x59000000, 0xA6000000};
+            s.shade.setBackground(new GradientDrawable(GradientDrawable.Orientation.TOP_BOTTOM, colors));
+            root.addView(s.shade, fill());
+            show(s, chosen(s.app));
+            s.tick = new Runnable() {
+                @Override public void run() {
+                    if (s.released) return;
+                    File want = chosen(s.app);
+                    if (!same(want, s.shown)) show(s, want);
+                    main.postDelayed(this, 30_000);
+                }
+            };
+            main.postDelayed(s.tick, 30_000);
+        }
+        root.addView(home, fill());
+        return root;
+    }
+
+    private static void show(final State s, final File f) {
+        s.shown = f;
+        active = f != null || Prefs.cinema();
+        if (f == null) {   // none due now: the home screen's own background (or Cinema's black)
+            s.image.setVisibility(View.GONE);
+            s.image.setImageDrawable(null);
+            s.video.stopPlayback();
+            s.video.setVisibility(View.GONE);
+            s.shade.setVisibility(Prefs.cinema() ? View.VISIBLE : View.GONE);
+            return;
+        }
+        s.shade.setVisibility(View.VISIBLE);
+        if (isVideo(f)) {
+            s.image.setVisibility(View.GONE);
+            s.image.setImageDrawable(null);
+            s.video.setVisibility(View.VISIBLE);
+            s.video.setVideoPath(f.getPath());
+        } else {
+            s.video.stopPlayback();
+            s.video.setVisibility(View.GONE);
+            s.image.setVisibility(View.VISIBLE);
+            final int width = Math.max(1280, Math.min(3840, s.app.getResources().getDisplayMetrics().widthPixels));
+            worker.execute(() -> {
+                final Bitmap bitmap = decode(f, width);
+                if (bitmap == null) return;
+                main.post(() -> {
+                    if (s.released || !same(s.shown, f)) return;   // gone, or a newer one is due already
+                    s.image.setAlpha(0f);
+                    s.image.setImageBitmap(bitmap);
+                    s.image.animate().alpha(1f).setDuration(900).start();
+                });
+            });
+        }
+    }
+
+    private static ViewGroup.LayoutParams fill() {
+        return new FrameLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT);
+    }
+
+    /** Pauses and resumes a video wallpaper with the screen. */
+    static void pause(View root) {
+        State s = state(root);
+        if (s != null && s.video != null && s.video.getVisibility() == View.VISIBLE) s.video.pause();
+    }
+
+    static void resume(View root) {
+        State s = state(root);
+        if (s == null || s.video == null) return;
+        File want = chosen(s.app);
+        if (!same(want, s.shown)) show(s, want);
+        else if (s.video.getVisibility() == View.VISIBLE) s.video.start();
+    }
+
+    static void release(View root) {
+        State s = state(root);
+        if (s != null) {
+            if (latestState == s) latestState = null;
+            s.released = true;
+            if (s.tick != null) main.removeCallbacks(s.tick);
+            if (s.video != null) s.video.stopPlayback();
+        }
+        active = false;
+    }
+
+    /** A photo at the screen's size, never bigger (sharp, not blurred, and light on memory). */
+    private static Bitmap decode(File f, int wantedWidth) {
+        try {
+            BitmapFactory.Options o = new BitmapFactory.Options();
+            o.inJustDecodeBounds = true;
+            BitmapFactory.decodeFile(f.getPath(), o);
+            int sample = 1;
+            while (o.outWidth / (sample * 2) >= wantedWidth) sample *= 2;
+            o = new BitmapFactory.Options();
+            o.inSampleSize = sample;
+            return BitmapFactory.decodeFile(f.getPath(), o);
+        } catch (RuntimeException | OutOfMemoryError e) {
+            AppLog.w("wallpaper photo: " + e.getMessage());
+            return null;
+        }
+    }
+}
