     /**
      * Closes what runs in the background (not the apps you have open, not the TV's own services): the TV's memory
      * frees up. Says how much came back.
      */
     private void clearMemory() {
         final Context app = getApplicationContext();
         final android.os.Handler ui = new android.os.Handler(android.os.Looper.getMainLooper());
         new Thread(() -> {
             try {
                 android.app.ActivityManager am = (android.app.ActivityManager) app.getSystemService(Context.ACTIVITY_SERVICE);
                 android.app.ActivityManager.MemoryInfo info = new android.app.ActivityManager.MemoryInfo();
                 am.getMemoryInfo(info);
                 long before = info.availMem;
                 for (android.content.pm.ApplicationInfo a : app.getPackageManager().getInstalledApplications(0)) {
                     if (a.packageName.equals(app.getPackageName())) continue;
                     if ((a.flags & (android.content.pm.ApplicationInfo.FLAG_PERSISTENT | android.content.pm.ApplicationInfo.FLAG_SYSTEM)) != 0 || a.packageName.startsWith("com.tcl.")) continue;
                     am.killBackgroundProcesses(a.packageName);
                 }
                 Thread.sleep(900);
                 am.getMemoryInfo(info);
                 final long freed = Math.max(0, (info.availMem - before) / (1024 * 1024));
                 ui.post(() -> android.widget.Toast.makeText(app,
                         Ui.tr("Memory cleared") + (freed > 0 ? ": +" + freed + " MB" : ""), android.widget.Toast.LENGTH_LONG).show());
             } catch (RuntimeException | InterruptedException e) {
                 AppLog.w("clear memory: " + e.getMessage());
             }
         }).start();
     }
 
